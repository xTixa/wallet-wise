PORT=3000

# Connection string do Neon (Dashboard Neon > Connection Details)
# Usa a "pooled connection" da Neon para DATABASE_URL
DATABASE_URL="postgresql://utilizador:password@ep-xxxx-pooler.regiao.aws.neon.tech/dbname?sslmode=require"

# Usa a "direct connection" (sem -pooler) para migrations do Prisma
DIRECT_URL="postgresql://utilizador:password@ep-xxxx.regiao.aws.neon.tech/dbname?sslmode=require"

JWT_SECRET=troca-isto-por-um-segredo-aleatorio

# Em produção, define o(s) domínio(s) do frontend, separados por vírgula.
# Ex: https://wallet-wise.vercel.app
# Em branco/omitido, aceita qualquer origem (só para desenvolvimento local).
CORS_ORIGIN=

# URL do frontend, usado para montar o link no email de recuperação de password.
FRONTEND_URL=http://localhost:5174

# Conta Gmail usada para enviar emails (recuperação de password).
# GMAIL_APP_PASSWORD é uma "App Password" gerada em
# myaccount.google.com/apppasswords (exige verificação em 2 passos ativa).
GMAIL_USER=
GMAIL_APP_PASSWORD=
